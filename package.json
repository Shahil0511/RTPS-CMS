{
  "name": "libas-vms",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Video Management System: live RTSP monitoring, recording playback, health monitoring, RBAC and audit logs.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -n web,mediamtx -c magenta,cyan \"npm:dev:web\" \"npm:mediamtx\"",
    "dev:web": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "node --env-file=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env --import=tsx scripts/migrate.ts",
    "db:studio": "node --env-file=.env node_modules/drizzle-kit/bin.cjs studio",
    "db:seed": "node --env-file=.env --import=tsx scripts/seed.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "mediamtx:download": "node scripts/download-mediamtx.mjs",
    "mediamtx": "node scripts/run-mediamtx.mjs",
    "dev:all": "npm run dev",
    "recorder:add": "node --env-file=.env --conditions=react-server --import=tsx scripts/add-recorder.ts",
    "health:run": "node --env-file=.env --conditions=react-server --import=tsx scripts/health-check.ts",
    "estate:import": "node --env-file-if-exists=.env --conditions=react-server --import=tsx scripts/import-stores.ts",
    "dev:clean": "node scripts/clean-dev.mjs && npm run dev"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "hls.js": "^1.7.4",
    "jose": "^6.2.15",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
