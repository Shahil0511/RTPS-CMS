# ---------------------------------------------------------------------------
# Libas VMS - environment configuration
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# Public URL of this app (used for links and cookies)
APP_URL=http://localhost:3000
NODE_ENV=development

# PostgreSQL connection
DATABASE_URL=postgres://user:password@host:5432/database
# All tables live in this dedicated schema so other data in the database is never touched
DATABASE_SCHEMA=vms
PGSSL=false

# 64+ hex chars. Signs login sessions and stream tokens. Rotate to log everyone out.
SESSION_SECRET=change-me-generate-with-openssl-rand-hex-48
# Exactly 64 hex chars (32 bytes). Encrypts camera passwords at rest. Changing it makes stored passwords unreadable.
ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32

# Session lifetime in hours
SESSION_TTL_HOURS=12

# ---- MediaMTX streaming server ----
# Internal URLs used by the Node.js server (API + playback).
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_PLAYBACK_URL=http://127.0.0.1:9996
# Public base URLs the BROWSER uses for WebRTC and HLS. Use the host's LAN IP when users are on other machines.
MEDIAMTX_PUBLIC_WEBRTC_URL=http://localhost:8889
MEDIAMTX_PUBLIC_HLS_URL=http://localhost:8888
# Service account the app uses to call the MediaMTX API/playback (validated by /api/internal/mediamtx-auth)
MEDIAMTX_API_USER=vms-service
MEDIAMTX_API_PASS=change-me
# Secret in MediaMTX's auth callback URL; only MediaMTX may call /api/internal/mediamtx-auth
MEDIAMTX_AUTH_SECRET=change-me-random-24-bytes

# Recording defaults applied to new cameras
RECORDING_ROOT=./recordings
DEFAULT_RECORD_ENABLED=false
DEFAULT_RETENTION_DAYS=7
RECORD_SEGMENT_MINUTES=15

# Playback from the recorders (NVR/DVR). Nothing is stored on this server.
# Pull live video only while someone watches (keeps NVR bandwidth low)
LIVE_ON_DEMAND=true
NVR_PLAYBACK_MAX_MINUTES=180
NVR_PLAYBACK_RANGE_HEADER=true

# Health monitor
HEALTH_CHECK_INTERVAL_SECONDS=20
HEALTH_TCP_TIMEOUT_MS=3000

# ---- Email alerts and daily health report (optional) ----
# Leave SMTP_HOST empty to run without email: messages are kept in the outbox (status SKIPPED_NO_SMTP) and shown in the UI.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (usually port 465); false uses STARTTLS when the server offers it
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender, e.g. "Libas VMS <vms-alerts@libas.in>"
SMTP_FROM=
# Timezone for alert timestamps and the daily report window
ALERT_TIMEZONE=Asia/Kolkata

# Initial administrator (created by `npm run db:seed` when no users exist)
ADMIN_EMAIL=admin@libas.in
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=System Administrator

# Optional: NVR credential file imported by the seed script (format: "Table Number: -N" followed by an rtsp:// URL)
SEED_CAMERA_FILE=./link.txt
